@{
    var current = Context.Request.Path.Value ?? "/";
    bool IsActive(string p) => current.StartsWith(p, StringComparison.OrdinalIgnoreCase)
        && (current.Length == p.Length || current[p.Length] == '/') && !(p == "/Products" && current.StartsWith("/Products/", StringComparison.OrdinalIgnoreCase));
    bool IsUnder(string p) => current.StartsWith(p, StringComparison.OrdinalIgnoreCase);
}
